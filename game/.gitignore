# =======================================================================
# REN'PY SPECIFIC RULES
# =======================================================================

# Ren'Py compiled script files
*.rpyc
*.rpymc

# Save directories, local persistent data, and performance cache
/game/saves/
/game/cache/
*.save

# System errors and automated logs generated by Ren'Py
/errors.txt
/log.txt
/traceback.txt


# =======================================================================
# MEDIA & BINARY ASSETS
# =======================================================================

# Ignore all videos in the movies folder to avoid GitHub size limits
game/movies/


# =======================================================================
# SYSTEM & CODE EDITOR CLUTTER
# =======================================================================

# VS Code local workspace configurations
.vscode/

# MacOS & Windows local system files
.DS_Store
Thumbs.db
Desktop.ini